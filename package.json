{
  "authors": [
    "Steve Kellock",
    "Levi Buzolic"
  ],
  "bin": {
    "osnap": "bin/osnap"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "minimist": "^1.2.7",
    "tempfile": "^5.0.0",
    "which": "^7.0.0"
  },
  "description": "A CLI for grabbing ios/android screenshots and saving to your clipboard or filesystem.",
  "resolutions": {
    "got": "^11.8.5",
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/minimist": "^1.2.2",
    "@types/node": "^26.2.0",
    "@types/which": "^3.0.0",
    "jest": "^30.4.2",
    "np": "^12.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.3"
  },
  "files": [
    "bin/osnap",
    "macos/pbcopyimg",
    "README.md",
    "src/*.js"
  ],
  "keywords": [
    "ios",
    "android",
    "screenshot"
  ],
  "license": "MIT",
  "name": "@ferocia-oss/osnap",
  "np": {
    "yarn": true,
    "branch": "main"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ferocia/osnap.git"
  },
  "scripts": {
    "prebuild": "yarn clean",
    "build": "tsc -p .",
    "build:mac": "gcc -Wall -O3 -ObjC -framework Foundation -framework AppKit -o macos/pbcopyimg macos/pbcopyimg.m",
    "clean": "bash ./scripts/clean.sh",
    "pretty": "prettier --no-semi --single-quote --print-width 100 --parser typescript --write src/**/*.ts",
    "watch": "tsc -p . -w",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prerelease": "yarn build",
    "release": "np"
  },
  "type": "module",
  "version": "1.3.5"
}
